<UserControl x:Class="UCut.Desktop.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Protokolldatei öffnen" Command="{Binding OpenFileCommand}"/>
                <Button Content="Ausgabeordner öffnen" Command="{Binding OpenFolderCommand}" Margin="0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Protokoll"/>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="List" ItemsSource="{Binding Lines}" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
