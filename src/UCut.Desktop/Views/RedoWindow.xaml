<Window x:Class="UCut.Desktop.Views.RedoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UCut.Desktop"
        Title="Clip neu machen" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" Icon="pack://application:,,,/Assets/ucut-256.png">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <local:EqualsConverter x:Key="Eq"/>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H1}" Text="Clip neu machen"/>
            <TextBlock Style="{StaticResource Subtle}" Text="{Binding Title}"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Abbrechen" IsCancel="True" Margin="0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnRun">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Neu machen" Foreground="White"/></StackPanel>
            </Button>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Layout -->
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Aufbau"/>
                    <WrapPanel Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="mode" Content="Automatisch" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=auto}"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="mode" Content="Cam oben" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Split}"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="mode" Content="Ohne Cam" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Crop}"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="mode" Content="Unscharfer Rand" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Blur}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding CamHint}" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,8"/>
                    <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Background="Black" HorizontalAlignment="Left"
                          Visibility="{Binding IsLandscape, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding Frame}" Stretch="Fill"/>
                        <Canvas x:Name="Overlay" Background="Transparent" Cursor="Cross" ClipToBounds="True"
                                MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp">
                            <Rectangle x:Name="CamBox" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Fill="#33FF5A2E" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" MaxWidth="640" Margin="0,8,0,0"
                               Text="Dieser Clip ist schon im Hochformat, der Aufbau bleibt wie er ist."
                               Visibility="{Binding IsLandscape, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Words -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H2}" Text="Untertitel"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding WordsHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Words}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Subtle}" FontSize="11" Text="{Binding TimeText, Mode=OneWay}"/>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="70"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
