<UserControl x:Class="UCut.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UCut.Desktop">
    <UserControl.Resources>
        <local:EqualsConverter x:Key="Eq"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <Style x:Key="SectionBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Gallery -->
        <DockPanel Margin="24,20,12,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Width="240" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource SubtleTextBrush}" Margin="10,0,0,0"/>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" ToolTip="Titel oder gesprochener Text"/>
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Neu laden" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Ausgabeordner öffnen" Command="{Binding OpenOutputCommand}"/>
                    <Button Command="{Binding SubtitlesAllCommand}" Margin="0,0,8,0" Visibility="{Binding HasPendingSubtitles, Converter={StaticResource BoolToVis}}"
                            ToolTip="Clips, die ohne Instant Clip (ohne Untertitel) gemacht wurden, bekommen jetzt ihre Untertitel. Schnitt und Texte bleiben.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED1E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PendingSubtitlesText}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RecreateAllCommand}" Margin="0,0,8,0"
                            ToolTip="Alle angezeigten Clips genau wie vorher neu rendern (Filter nach Spiel wirkt mit)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Recreate"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Primary}" Command="{Binding AddClipsCommand}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Clips hinzufügen" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H1}" Text="Deine Clips"/>
                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding CountText}" Margin="12,6,0,0" FontSize="14"/>
                </StackPanel>
            </DockPanel>

            <!-- Game filter + sorting -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="sort" Content="Neueste" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=new}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="sort" Content="😂 Lustigste" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=funny}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="sort" Content="Bester Score" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=score}" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="Spiel" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Subtle}"/>
                    <ComboBox ItemsSource="{Binding GameOptions}" SelectedValue="{Binding Game}" SelectedValuePath="Name" DisplayMemberPath="Label"
                              MinWidth="280" MaxDropDownHeight="520" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                              ToolTip="Nur Clips von diesem Spiel zeigen. Tipp: Liste aufklappen und den Anfang vom Namen tippen."/>
                    <Button Command="{Binding UnloadShownCommand}" Margin="12,0,0,0"
                            ToolTip="Nimmt alle gerade angezeigten Clips aus UCut raus (Spiel-Filter und Suche wirken mit). Nichts wird gelöscht, mit „Entladene zurückholen“ sind sie wieder da.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding UnloadShownText}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReloadUnloadedCommand}" Margin="8,0,0,0" Visibility="{Binding HasUnloaded, Converter={StaticResource BoolToVis}}"
                            ToolTip="Holt alle entladenen Clips wieder in UCut zurück">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ReloadUnloadedText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- Empty state -->
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                        CornerRadius="16" Margin="0,8,12,24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                        <TextBlock Text="Noch keine Clips" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="13" HorizontalAlignment="Center"
                                   Text="Zieh Videos hier rein, lade alte Twitch-Clips oder schalte unten links „Auto“ für deinen Aitum-Ordner an."/>
                    </StackPanel>
                </Border>

                <DockPanel Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8,0,8" Content="{Binding MoreText}" Command="{Binding ShowMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"
                        ToolTip="Es werden immer 120 Clips auf einmal gezeigt, damit UCut flüssig bleibt. Suche, Spiel-Filter und Sortierung gehen über alle Clips."/>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,12,10"
                        Visibility="{Binding HasMarked, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="{Binding MarkedText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding UnloadMarkedCommand}" Margin="0,0,8,0" ToolTip="Aus UCut rausnehmen, ohne zu löschen (Ordner _Entladen)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Entladen"/></StackPanel>
                            </Button>
                            <Button Command="{Binding DownloadMarkedCommand}" Margin="0,0,8,0" ToolTip="Kopien mit dem Titel als Namen in deinen Downloads-Ordner">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Herunterladen"/></StackPanel>
                            </Button>
                            <Button Command="{Binding SubtitlesMarkedCommand}" Margin="0,0,8,0" Visibility="{Binding MarkedHasPendingSubtitles, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Untertitel nachholen"/></StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteMarkedCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Löschen"/></StackPanel>
                            </Button>
                            <Button Content="Auswahl aufheben" Click="ClearMarked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="Gallery" ItemsSource="{Binding Clips}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                         SelectionChanged="GallerySelectionChanged"
                         ToolTip="Mehrere Clips: Strg-Klick, Shift-Klick oder Strg+A"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="12" Margin="0,0,14,14" BorderThickness="2" BorderBrush="Transparent" Background="{StaticResource SurfaceBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="176">
                                <Grid Height="300" ClipToBounds="True">
                                    <Border CornerRadius="10,10,0,0" Background="#08090C">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,176,300" RadiusX="10" RadiusY="10"/>
                                        </Border.Clip>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                            Visibility="{Binding FunnyText, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding FunnyText}" FontWeight="SemiBold" Foreground="{StaticResource FunBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip="UCut-Score">
                                        <TextBlock Text="{Binding Score}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                        <TextBlock Text="{Binding DurationText}" FontSize="11"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" ToolTip="Ohne Untertitel gemacht (Instant Clip aus)"
                                            Visibility="{Binding SubtitlesPending, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ohne Untertitel" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource OkBrush}" ToolTip="{Binding UploadedPlatforms}"
                                            Visibility="{Binding IsUploaded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="10,8,10,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                                    <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0">
                                        <Run Text="{Binding Game, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Column="1" Width="420" Background="{StaticResource SidebarBrush}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" DataContext="{Binding Selected}">
                    <Grid Height="460" Background="Black" MouseLeftButtonDown="OnPlayerClick" ToolTip="Doppelklick: Vollbild">
                        <MediaElement x:Name="Player" Source="{Binding VideoUri}" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Volume="{Binding Volume, Source={x:Static local:Sound.Current}, Mode=OneWay}"
                                      MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"/>
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE769;" Click="OnPlayPause"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Background="#AA000000"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE740;" Click="OnFullscreen" ToolTip="Vollbild (oder Doppelklick aufs Video)"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#AA000000"/>
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Slider DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Volume, Source={x:Static local:Sound.Current}}" ToolTip="{Binding Text, Source={x:Static local:Sound.Current}}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding Icon, Source={x:Static local:Sound.Current}}" Margin="10,0,6,0" VerticalAlignment="Center"/>
                        <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="OnSeek" IsMoveToPointEnabled="True" SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap">
                        <Run Text="{Binding Game, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceText, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource Chip}" Background="{StaticResource Surface2Brush}">
                            <TextBlock><Run Text="Score "/><Run Text="{Binding Score, Mode=OneWay}" FontWeight="Bold"/><Run Text="/100"/></TextBlock>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{StaticResource Surface2Brush}" Visibility="{Binding FunnyText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FunnyText}" Foreground="{StaticResource FunBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{StaticResource Surface2Brush}" Visibility="{Binding Layout, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Layout}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding FunnyReason}" Visibility="{Binding FunnyReason, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding LaughText, Mode=OneWay}" Visibility="{Binding LaughText, Converter={StaticResource NullToVis}}"/>

                    <WrapPanel Margin="0,12,0,4" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button Style="{StaticResource Primary}" Command="{Binding EditCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Im Schnittraum bearbeiten" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SubtitlesNowCommand}" Margin="0,0,8,8" Visibility="{Binding Selected.SubtitlesPending, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                ToolTip="Dieser Clip wurde ohne Untertitel gemacht (Instant Clip aus). Jetzt transkribieren, Schnitt und Texte bleiben.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED1E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Untertitel jetzt erstellen"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RedoCommand}" Margin="0,0,8,8" ToolTip="Cam von Hand setzen, ohne Cam machen oder Untertitel korrigieren">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Create"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Im Videoplayer abspielen" Command="{Binding PlayCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Im Ordner zeigen" Command="{Binding ShowInFolderCommand}" Margin="0,0,8,8"/>
                        <Button Command="{Binding DownloadCommand}" Margin="0,0,8,8" ToolTip="Legt eine Kopie des fertigen Clips mit dem Titel als Namen in deinen Downloads-Ordner">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Download"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Entladen: aus UCut rausnehmen, ohne zu löschen (kommt in den Ordner _Entladen)" Command="{Binding UnloadCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clip löschen" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>

                    <!-- Upload -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Hochladen"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Noch kein Konto verbunden. Verbinde deine Konten unter Einstellungen → Konten zum Hochladen."
                                       Visibility="{Binding HasAccounts, Converter={StaticResource InvBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding UploadTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource Primary}" Command="{Binding UploadNowCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Auf ausgewählte Konten hochladen" Foreground="White"/></StackPanel>
                                </Button>
                                <Button Content="Konten verwalten" Command="{Binding ManageAccountsCommand}" Margin="0,0,8,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding ClearUploadFolderCommand}" Margin="0,0,8,0"
                                        ToolTip="Löscht die Kopien, die „Hochladen“ mit dem Titel als Dateinamen angelegt hat. Deine Clips bleiben.">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Hochlad-Ordner leeren"/></StackPanel>
                                </Button>
                                <Button Content="&#xE838;" FontFamily="{StaticResource Icons}" Command="{Binding OpenUploadFolderCommand}" ToolTip="Hochlad-Ordner öffnen"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Selected.UploadedText}"/>
                        </StackPanel>
                    </Border>

                    <!-- Texts per platform -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Kopieren" Margin="0" Padding="8,4"
                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="tiktok"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Hochladen" Margin="0,0,6,0" Padding="10,4"
                                        ToolTip="Kopiert den Text, zeigt den Clip im Ordner und öffnet die Upload-Seite. Clip in den Browser ziehen, Text mit Strg+V einfügen."
                                        Command="{Binding DataContext.UploadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="tiktok"/>
                                <TextBlock Style="{StaticResource H2}" Text="TikTok" Margin="0"/>
                            </DockPanel>
                            <TextBox Style="{StaticResource SectionBox}" Text="{Binding TikTokCaption, UpdateSourceTrigger=PropertyChanged}" MinHeight="70"/>
                            <CheckBox Content="Hochgeladen" IsChecked="{Binding UploadedTikTok}" Margin="0,8,0,0" ToolTip="Haken setzen, wenn der Clip auf TikTok online ist. In der Galerie bekommt er dann einen grünen Haken."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Kopieren" Margin="0" Padding="8,4"
                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="youtube"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Hochladen" Margin="0,0,6,0" Padding="10,4"
                                        ToolTip="Kopiert den Text, zeigt den Clip im Ordner und öffnet die Upload-Seite. Clip in den Browser ziehen, Text mit Strg+V einfügen."
                                        Command="{Binding DataContext.UploadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="youtube"/>
                                <TextBlock Style="{StaticResource H2}" Text="YouTube Shorts" Margin="0"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Subtle}" Text="Titel"/>
                            <TextBox Style="{StaticResource SectionBox}" AcceptsReturn="False" Text="{Binding YouTubeTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Subtle}" Text="Beschreibung"/>
                            <TextBox Style="{StaticResource SectionBox}" Text="{Binding YouTubeDescription, UpdateSourceTrigger=PropertyChanged}" MinHeight="60"/>
                            <TextBlock Style="{StaticResource Subtle}" Text="Tags"/>
                            <TextBox Style="{StaticResource SectionBox}" Text="{Binding YouTubeTags, UpdateSourceTrigger=LostFocus}"/>
                            <Button Content="Vorschaubild ansehen" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="Lustigste Stelle mit Titel. Wird beim Hochladen auf YouTube automatisch mitgeschickt."
                                    Visibility="{Binding HasYouTubeThumbnail, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.OpenYouTubeThumbnailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <CheckBox Content="Hochgeladen" IsChecked="{Binding UploadedYouTube}" Margin="0,8,0,0" ToolTip="Haken setzen, wenn der Clip auf YouTube online ist. In der Galerie bekommt er dann einen grünen Haken."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Kopieren" Margin="0" Padding="8,4"
                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="instagram"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Hochladen" Margin="0,0,6,0" Padding="10,4"
                                        ToolTip="Kopiert den Text, zeigt den Clip im Ordner und öffnet die Upload-Seite. Clip in den Browser ziehen, Text mit Strg+V einfügen."
                                        Command="{Binding DataContext.UploadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="instagram"/>
                                <TextBlock Style="{StaticResource H2}" Text="Instagram Reels" Margin="0"/>
                            </DockPanel>
                            <TextBox Style="{StaticResource SectionBox}" Text="{Binding InstagramCaption, UpdateSourceTrigger=PropertyChanged}" MinHeight="60"/>
                            <CheckBox Content="Hochgeladen" IsChecked="{Binding UploadedInstagram}" Margin="0,8,0,0" ToolTip="Haken setzen, wenn der Clip auf Instagram online ist. In der Galerie bekommt er dann einen grünen Haken."/>
                        </StackPanel>
                    </Border>
                    <Button Content="Texte speichern" HorizontalAlignment="Left"
                            Command="{Binding DataContext.SaveTextsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Änderungen werden auch beim Wechsel zu einem anderen Clip gespeichert. Gesprochener Text:"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Transcript}" FontStyle="Italic"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
